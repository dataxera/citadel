apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-admin-secret
  namespace: {{ namespace }}
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: citadel
type: kubernetes.io/basic-auth
stringData:
  username: "{{ operator_username }}"
  password: "{{ operator_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-auth-init-secret
  namespace: {{ namespace }}
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: citadel
type: Opaque
stringData:
  admin_password: "{{ admin_password }}"
  operator_username: "{{ operator_username }}"
  operator_password: "{{ operator_password }}"
