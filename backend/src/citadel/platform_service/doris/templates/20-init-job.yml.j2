apiVersion: batch/v1
kind: Job
metadata:
  name: {{ name }}-auth-init
  namespace: {{ namespace }}
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: citadel
spec:
  ttlSecondsAfterFinished: 300
  backoffLimit: 10
  template:
    metadata:
      labels:
        {% if project_title %}
        project: "{{ project_title }}"
        {% endif %}
        {% if service_title %}
        service: "{{ service_title }}"
        {% endif %}
        manager: citadel
    spec:
      restartPolicy: OnFailure
      {% if node_affinity_yaml %}
      affinity:
        nodeAffinity:
          {{ node_affinity_yaml | indent(10) }}
      {% endif %}
      containers:
        - name: init-auth
          image: "{{ fe_image }}:{{ fe_image_tag }}"
          command:
            - /bin/bash
            - -c
            - |
              set -e
              FE_HOST="{{ name }}-fe-service.{{ namespace }}.svc.cluster.local"
              FE_PORT="9030"

              echo "Waiting for Doris FE at ${FE_HOST}:${FE_PORT}..."
              until timeout 5 mysql -h "${FE_HOST}" -P "${FE_PORT}" -uroot --connect-timeout 2 -e "SELECT 1;" >/dev/null 2>&1 || timeout 5 mysql -h "${FE_HOST}" -P "${FE_PORT}" -uroot -p"${ADMIN_PASSWORD}" --connect-timeout 2 -e "SELECT 1;" >/dev/null 2>&1; do
                echo "FE not ready yet, sleeping 5s..."
                sleep 5
              done

              echo "Doris FE is reachable. Initializing authentication..."
              if timeout 5 mysql -h "${FE_HOST}" -P "${FE_PORT}" -uroot --connect-timeout 2 -e "SELECT 1;" >/dev/null 2>&1; then
                echo "Setting root password..."
                mysql -h "${FE_HOST}" -P "${FE_PORT}" -uroot -e "SET PASSWORD FOR 'root'@'%' = PASSWORD('${ADMIN_PASSWORD}');"
              else
                echo "Root password already set."
              fi

              echo "Ensuring management user ${OPERATOR_USER} exists..."
              mysql -h "${FE_HOST}" -P "${FE_PORT}" -uroot -p"${ADMIN_PASSWORD}" -e "
                CREATE USER IF NOT EXISTS '${OPERATOR_USER}'@'%' IDENTIFIED BY '${OPERATOR_PASSWORD}';
                SET PASSWORD FOR '${OPERATOR_USER}'@'%' = PASSWORD('${OPERATOR_PASSWORD}');
                GRANT NODE_PRIV, ADMIN_PRIV ON *.*.* TO '${OPERATOR_USER}'@'%';
              "
              echo "Doris authentication initialization completed successfully."
          env:
            - name: ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-auth-init-secret
                  key: admin_password
            - name: OPERATOR_USER
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-auth-init-secret
                  key: operator_username
            - name: OPERATOR_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-auth-init-secret
                  key: operator_password
