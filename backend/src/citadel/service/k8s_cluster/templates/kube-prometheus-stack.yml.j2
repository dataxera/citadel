apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: kube-prometheus-stack
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: citadel
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ chart_repo }}
    chart: {{ chart_name }}
    targetRevision: {{ chart_version }}
    helm:
      values: |
        grafana:
          enabled: false
        alertmanager:
          enabled: false
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeEtcd:
          enabled: false
        kubeProxy:
          enabled: false
        kubeStateMetrics:
          enabled: true
        nodeExporter:
          enabled: true
        prometheusOperator:
          image:
            registry: {{ operator_registry }}
            repository: {{ operator_repository }}
            tag: "{{ operator_tag }}"
          prometheusConfigReloader:
            image:
              registry: {{ config_reloader_registry }}
              repository: {{ config_reloader_repository }}
              tag: "{{ config_reloader_tag }}"
          admissionWebhooks:
            patch:
              image:
                registry: {{ webhook_certgen_registry }}
                repository: {{ webhook_certgen_repository }}
                tag: "{{ webhook_certgen_tag }}"
        prometheus:
          prometheusSpec:
            retention: 15d
            image:
              registry: {{ main_registry }}
              repository: {{ main_repository }}
              tag: "{{ main_tag }}"
        kube-state-metrics:
          image:
            registry: {{ kube_state_metrics_registry }}
            repository: {{ kube_state_metrics_repository }}
            tag: "{{ kube_state_metrics_tag }}"
        prometheus-node-exporter:
          image:
            registry: {{ node_exporter_registry }}
            repository: {{ node_exporter_repository }}
            tag: "{{ node_exporter_tag }}"
            distroless: false
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - RespectIgnoreDifferences=true
    - ServerSideApply=true
