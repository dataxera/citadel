apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-mysql-lb
  namespace: {{ namespace }}
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
spec:
  type: LoadBalancer
  ports:
    - name: query
      port: 3306
      targetPort: 9030
      protocol: TCP
  selector:
    app.kubernetes.io/component: fe
    app.kubernetes.io/instance: {{ name }}
