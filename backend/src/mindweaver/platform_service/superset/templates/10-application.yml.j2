apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_name }}
  source:
    repoURL: {{ chart_repo }}
    chart: {{ chart_name }}
    targetRevision: {{ chart_version }}
    helm:
      values: |
        extraEnv:
          REQUESTS_CA_BUNDLE: "/etc/ssl/certs/mindweaver-ca.crt"
          SSL_CERT_FILE: "/etc/ssl/certs/mindweaver-ca.crt"

        extraVolumes:
          - name: ca-certs
            secret:
              secretName: {{ name }}-tls
              items:
                - key: ca.crt
                  path: ca.crt
                - key: tls.crt
                  path: tls.crt
                - key: tls.key
                  path: tls.key

        extraVolumeMounts:
          - name: ca-certs
            mountPath: /etc/ssl/certs/mindweaver-ca.crt
            subPath: ca.crt
            readOnly: true
          - name: ca-certs
            mountPath: /etc/superset/trino-certs/tls.crt
            subPath: tls.crt
            readOnly: true
          - name: ca-certs
            mountPath: /etc/superset/trino-certs/tls.key
            subPath: tls.key
            readOnly: true

        postgresql:
          enabled: false
        
        image:
          {% if override_image %}
          repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
          tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
          {% else %}
          repository: ghcr.io/kagesenshi/mindweaver/superset
          tag: 6.1.0-rev.1
          {% endif %}
          pullPolicy: IfNotPresent

        initImage:
          repository: {{ init_image }}
          tag: "{{ init_image_tag }}"
          pullPolicy: IfNotPresent
        
        service:
          type: NodePort
          port: 8088
          nodePort: 
            http: ~
        
        redis:
          enabled: true # Internal redis for caching/celery is fine for now
          image:
            repository: {{ redis_image }}
            tag: "{{ redis_image_tag }}"
        
        supersetNode:
          connections:
            db_type: "postgresql+psycopg2"
            db_host: "{{ db_host }}"
            db_port: "{{ db_port }}"
            db_user: "{{ db_user }}"
            db_pass: "{{ db_pass }}"
            db_name: "{{ db_name }}"
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        supersetWorker:
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        init:
          adminUser:
            username: admin
            password: {{ admin_password }}
          loadExamples: {{ 'true' if load_examples else 'false' }}
          initscript: |-
            #!/bin/sh
            set -eu
            echo "Upgrading DB schema..."
            superset db upgrade
            echo "Initializing roles..."
            superset init
            echo "Creating admin user..."
            superset fab create-admin \
                            --username admin \
                            --firstname Superset \
                            --lastname Admin \
                            --email admin@superset.com \
                            --password {{ admin_password }} \
                            || true
            {% if load_examples %}
            echo "Configuring examples database URI..."
            python3 -c "
            from superset.app import create_app
            app = create_app()
            with app.app_context():
                from superset import db
                from superset.models.core import Database
                d = db.session.query(Database).filter_by(database_name='examples').first()
                target_uri = app.config.get('SQLALCHEMY_EXAMPLES_URI') or app.config['SQLALCHEMY_DATABASE_URI']
                if d:
                    if d.sqlalchemy_uri_decrypted != target_uri:
                        print(f'Updating examples database URI to {target_uri}')
                        d.set_sqlalchemy_uri(target_uri)
                    d.expose_in_sqllab = True
                    db.session.commit()
            "
            echo "Loading examples..."
            superset load_examples --force
            echo "Fixing example datasets schema and views..."
            python3 -c "
            from superset.app import create_app
            app = create_app()
            with app.app_context():
                from superset import db
                from superset.models.core import Database
                from superset.connectors.sqla.models import SqlaTable
                from sqlalchemy import text

                examples_db = db.session.query(Database).filter_by(database_name='examples').first()
                if examples_db:
                    examples_db.expose_in_sqllab = True
                    for tbl in db.session.query(SqlaTable).filter_by(database_id=examples_db.id).all():
                        if tbl.schema == 'main':
                            print(f'Updating schema for {tbl.table_name} from main to public')
                            tbl.schema = 'public'
                    db.session.commit()

                    try:
                        with examples_db.get_sqla_engine().begin() as conn:
                            if examples_db.backend == 'postgresql':
                                conn.execute(text('CREATE SCHEMA IF NOT EXISTS main;'))
                                conn.execute(text('''
                                    DO \$\$
                                    DECLARE
                                        r RECORD;
                                    BEGIN
                                        FOR r IN (SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE') LOOP
                                            EXECUTE 'CREATE OR REPLACE VIEW main.' || quote_ident(r.table_name) || ' AS SELECT * FROM public.' || quote_ident(r.table_name);
                                        END LOOP;
                                    END \$\$;
                                '''))
                                print('Created main schema views in PostgreSQL')
                    except Exception as e:
                        print(f'Warning: Failed to create main schema alias in examples db: {e}')
            "
            {% endif %}
            if [ -f /app/configs/import_datasources.yaml ]; then
              echo "Importing datasources..."
              superset import_datasources -p /app/configs/import_datasources.yaml
            fi
            echo "Cleaning up removed datasources..."
            python3 -c "
            import os
            import yaml
            from superset.app import create_app
            app = create_app()
            with app.app_context():
                from superset import db
                from superset.models.core import Database
                expected_names = ['main']
                {% if load_examples %}
                expected_names.append('examples')
                {% endif %}
                config_path = '/app/configs/import_datasources.yaml'
                if os.path.exists(config_path):
                    with open(config_path, 'r') as f:
                        config = yaml.safe_load(f) or {}
                    expected_names.extend([db_entry['database_name'] for db_entry in config.get('databases', [])])
                for d in db.session.query(Database).all():
                    if d.database_name not in expected_names:
                        print(f'Deleting database connection: {d.database_name}')
                        db.session.delete(d)
                db.session.commit()
            "

        configOverrides:
          secret_key: |
            SECRET_KEY = '{{ superset_secret_key }}'
            RECAPTCHA_PUBLIC_KEY = ''
            RECAPTCHA_PRIVATE_KEY = ''
            SQLALCHEMY_EXAMPLES_URI = SQLALCHEMY_DATABASE_URI
          security_manager: |
            from superset.security import SupersetSecurityManager

            class CustomSecurityManager(SupersetSecurityManager):
                def update_user_auth_stat(self, user, success=True):
                    if success and user:
                        try:
                            {% if sqllab_enabled %}
                            sql_lab_role = self.find_role("sql_lab")
                            if sql_lab_role and sql_lab_role not in user.roles:
                                user.roles.append(sql_lab_role)
                                try:
                                    self.session.commit()
                                except AttributeError:
                                    from superset import db
                                    db.session.commit()
                            {% else %}
                            sql_lab_role = self.find_role("sql_lab")
                            if sql_lab_role and sql_lab_role in user.roles:
                                user.roles.remove(sql_lab_role)
                                try:
                                    self.session.commit()
                                except AttributeError:
                                    from superset import db
                                    db.session.commit()
                            {% endif %}
                        except Exception as e:
                            import logging
                            logging.error(f"Failed to update sql_lab role: {e}")
                    super().update_user_auth_stat(user, success)

            CUSTOM_SECURITY_MANAGER = CustomSecurityManager

            import trino.auth
            ALLOWED_EXTRA_AUTHENTICATIONS = {
                "trino": {
                    "jwt": trino.auth.JWTAuthentication,
                    "certificate": trino.auth.CertificateAuthentication
                }
            }
          {% if ldap %}
          ldap: |
            from flask_appbuilder.security.manager import AUTH_LDAP
            AUTH_TYPE = AUTH_LDAP
            AUTH_LDAP_SERVER = "{{ ldap.server_url }}"
            AUTH_LDAP_BIND_USER = "{{ ldap.bind_dn }}"
            AUTH_LDAP_BIND_PASSWORD = "{{ ldap.bind_password }}"
            AUTH_LDAP_SEARCH = "{{ ldap.user_search_base }}"
            AUTH_LDAP_UID_FIELD = "{{ ldap.username_attr }}"
            {% if ldap.user_group_attr %}
            AUTH_LDAP_GROUP_FIELD = "{{ ldap.user_group_attr }}"
            {% endif %}
            # Allow users who are authenticated via LDAP to be registered in Superset
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Alpha"
            AUTH_LDAP_ALLOW_LOCAL_DB = True
            PERMANENT_SESSION_LIFETIME = 1800
          {% endif %}
          {% if auth_role_mapping %}
          role_mapping: |
            AUTH_ROLES_MAPPING = {
              {% for entity, roles in auth_role_mapping.items() %}
              "{{ entity }}": {{ roles | tojson }},
              {% endfor %}
            }

            AUTH_ROLES_SYNC_AT_LOGIN = True
          {% endif %}
          {% if ldap %}
          bootstrap_overrides: |
            from flask_appbuilder.security.manager import AUTH_LDAP

            def common_bootstrap_overrides(bootstrap_data: dict) -> dict:
                conf = bootstrap_data.get("conf", {})
                if conf.get("AUTH_TYPE") == AUTH_LDAP:
                    return {
                        **bootstrap_data,
                        "conf": {
                            **conf,
                            "AUTH_USER_REGISTRATION": False,
                        },
                    }
                return bootstrap_data

            COMMON_BOOTSTRAP_OVERRIDES_FUNC = common_bootstrap_overrides
          {% endif %}

        {% if datasources %}
        extraConfigs:
          import_datasources.yaml: |
            databases:
            {% for ds in datasources %}
            - database_name: "{{ ds.database_name }}"
              sqlalchemy_uri: "{{ ds.sqlalchemy_uri }}"
              expose_in_sqllab: {{ 'true' if ds.expose_in_sqllab else 'false' }}
              {% if ds.impersonate_user %}
              impersonate_user: true
              {% endif %}
              {% if ds.extra %}
              extra: |
                {{ ds.extra | tojson }}
              {% endif %}
              {% if ds.encrypted_extra %}
              encrypted_extra: |
                {{ ds.encrypted_extra | tojson }}
              {% endif %}
            {% endfor %}
        {% endif %}


  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
